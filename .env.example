# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

#App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
BIRTHDAY_SCHEDULER_SECRET=your_birthday_scheduler_secret

# Jamendo music search API
JAMENDO_CLIENT_ID=your_jamendo_client_id
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id
SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret

# Cloudflare R2 Storage (Music & Assets)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=omoide-music
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://your-r2-public-domain.r2.dev