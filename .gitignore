# ファイルを無視する設定の詳細は https://help.github.com/articles/ignoring-files/ を参照してください。

# 依存関係
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# テスト関連
/coverage
/__tests__/

# Next.js 関連
/.next/
/out/

# 本番ビルド関連
/build
tmp/
# その他
.DS_Store
*.pem

# デバッグ用ログ
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 環境変数ファイル
.env

# Vercel 関連
.vercel

# TypeScript 関連
*.tsbuildinfo

# エージェント・開発補助ツール関連
.agents/
.claude/
.codegraph/
.harness-core/
.gitnexus/
.serena/
docs/
